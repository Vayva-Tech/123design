# Site URL - used for SEO, sitemaps, and canonical URLs
# Development default: http://localhost:3000
# Production: Set to your canonical domain (e.g., https://123.design)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS Configuration
# Public client configuration (safe to expose to browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server-only secrets (never expose to browser bundle)
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=

# Analytics (Plausible — set your domain to enable)
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Sentry Error Monitoring (optional — leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
